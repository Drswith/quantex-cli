{
  "name": "quantex-cli",
  "version": "1.8.6",
  "description": "Agent-friendly lifecycle CLI for AI coding assistant CLIs: install, inspect, update, uninstall, run, and automate Codex, Claude Code, Gemini, Cursor, OpenCode, and more",
  "keywords": [
    "agent-cli",
    "agent-lifecycle",
    "ai",
    "ai-agent",
    "ai-coding",
    "ai-coding-assistant",
    "automation",
    "claude-code",
    "cli",
    "codex",
    "coding-agent",
    "coding-assistant",
    "cursor-cli",
    "developer-tools",
    "gemini-cli",
    "machine-readable",
    "opencode",
    "qtx",
    "quantex",
    "self-upgrade"
  ],
  "homepage": "https://github.com/Drswith/quantex-cli#readme",
  "bugs": "https://github.com/Drswith/quantex-cli/issues",
  "license": "Apache-2.0",
  "author": "Drswith <drswith@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drswith/quantex-cli.git"
  },
  "bin": {
    "qtx": "./dist/cli.mjs",
    "quantex": "./dist/cli.mjs"
  },
  "workspaces": [
    "packages/core"
  ],
  "files": [
    "dist",
    "!dist/bin",
    "!dist/bin/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "agent-catalog:generate": "bun run agent-catalog:manifest && bun run core-catalog:write",
    "agent-catalog:manifest": "bun run scripts/write-agent-catalog-manifest.ts",
    "build": "bun run build:core && bun run build:cli",
    "build:bin": "bun run build:meta && bun run scripts/build-bin.ts",
    "build:cli": "bun run build:meta && tsdown --config tsdown.config.ts",
    "build:core": "bun run --cwd packages/core build",
    "build:meta": "bun run scripts/write-build-metadata.ts",
    "ci:commit-policy": "bun run scripts/commit-policy.ts",
    "ci:context": "bun run scripts/ci-context.ts",
    "ci:path-taxonomy": "bun run scripts/path-taxonomy.ts",
    "ci:release-pr-policy": "bun run scripts/release-pr-policy.ts",
    "ci:release-publish-contract": "bun run scripts/release-seal-contract.ts",
    "ci:tag-release": "bun run scripts/tag-release.ts",
    "core-catalog:write": "bun run scripts/write-core-agent-catalog.ts",
    "dev": "bun run src/cli.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "memory:check": "bun run scripts/check-project-memory.ts",
    "openspec:archive-closure": "bun run scripts/openspec-archive-closure.ts",
    "openspec:list": "openspec list",
    "openspec:status": "openspec status --json",
    "openspec:validate": "openspec validate --all --no-interactive",
    "package:check": "bun run package:check:core && bun run package:check:cli",
    "package:check:cli": "bun run scripts/verify-package-distribution.ts",
    "package:check:core": "bun run scripts/verify-core-package-distribution.ts",
    "pr:body:check": "bun run scripts/pr-body-policy.ts",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "bun run build",
    "release:artifacts": "bun run scripts/release-artifacts.ts",
    "release:candidate": "bun run scripts/release-candidate.ts",
    "release:dry-run": "bun run scripts/release-candidate.ts --local",
    "release:smoke": "bun run scripts/verify-release-smoke.ts",
    "setup": "simple-git-hooks",
    "test": "vitest run",
    "test:container": "bun run scripts/test-isolation.ts docker",
    "test:sandbox": "bun run scripts/test-isolation.ts modal",
    "test:watch": "vitest",
    "typecheck": "bun run typecheck:cli && bun run typecheck:core",
    "typecheck:cli": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit --project packages/core/tsconfig.json"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "slice-ansi": "^8.0.0",
    "string-width": "^8.2.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.3.1",
    "@types/bun": "^1.3.11",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.0.1",
    "@types/prompts": "^2.4.9",
    "bun-types": "1.3.11",
    "lint-staged": "^16.2.7",
    "oxfmt": "0.47.0",
    "oxlint": "^1.62.0",
    "quantex-core": "0.1.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  },
  "simple-git-hooks": {
    "commit-msg": "bun run scripts/strip-cursor-coauthor.ts \"$1\"",
    "pre-commit": "bunx lint-staged",
    "pre-push": "bun run lint && bun run format:check && bun run typecheck && bun run openspec:validate && bun run memory:check"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,html,css,scss,less}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.11"
}
