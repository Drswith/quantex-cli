{
  "name": "pi",
  "displayName": "Pi",
  "homepage": "https://pi.dev",
  "binaryName": "pi",
  "selfUpdate": {
    "command": ["pi", "update"]
  },
  "supersededPackages": {
    "npm": ["@mariozechner/pi-coding-agent"]
  },
  "platforms": {
    "windows": [
      {
        "provider": "bun",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      }
    ],
    "macos": [
      {
        "provider": "bun",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      }
    ],
    "linux": [
      {
        "provider": "bun",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "@earendil-works/pi-coding-agent",
          "kind": "package"
        }
      }
    ]
  }
}
