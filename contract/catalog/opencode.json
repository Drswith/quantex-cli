{
  "name": "opencode",
  "displayName": "OpenCode",
  "homepage": "https://opencode.ai",
  "binaryName": "opencode",
  "selfUpdate": {
    "command": ["opencode", "upgrade"]
  },
  "platforms": {
    "windows": [
      {
        "provider": "bun",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      }
    ],
    "macos": [
      {
        "provider": "bun",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      },
      {
        "provider": "script",
        "target": {
          "id": "https://opencode.ai/install",
          "kind": "script",
          "binaryDirs": ["~/.opencode/bin"],
          "effect": {
            "command": "curl -fsSL https://opencode.ai/install | bash",
            "kind": "shell-script"
          }
        }
      }
    ],
    "linux": [
      {
        "provider": "bun",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      },
      {
        "provider": "npm",
        "target": {
          "id": "opencode-ai",
          "kind": "package"
        }
      },
      {
        "provider": "script",
        "target": {
          "id": "https://opencode.ai/install",
          "kind": "script",
          "binaryDirs": ["~/.opencode/bin"],
          "effect": {
            "command": "curl -fsSL https://opencode.ai/install | bash",
            "kind": "shell-script"
          }
        }
      }
    ]
  }
}
