{
  "program": {
    "name": "quantex",
    "description": "统一的 AI Agent CLI 管理工具"
  },
  "globalOptions": [
    {
      "id": "json",
      "flags": "--json",
      "description": "Output structured JSON",
      "value": "boolean"
    },
    {
      "id": "nonInteractive",
      "flags": "--non-interactive",
      "description": "Disable interactive prompts and confirmations",
      "value": "boolean"
    },
    {
      "id": "yes",
      "flags": "--yes",
      "description": "Automatically accept safe default confirmations",
      "value": "boolean"
    },
    {
      "id": "quiet",
      "flags": "--quiet",
      "description": "Suppress non-essential human logs",
      "value": "boolean"
    },
    {
      "id": "color",
      "flags": "--color <mode>",
      "description": "Color mode: auto, always, or never",
      "value": "string"
    },
    {
      "id": "dryRun",
      "flags": "--dry-run",
      "description": "Show what would happen without making changes",
      "value": "boolean"
    },
    {
      "id": "refresh",
      "flags": "--refresh",
      "description": "Refresh cached version metadata before returning results",
      "value": "boolean"
    },
    {
      "id": "noCache",
      "flags": "--no-cache",
      "description": "Bypass the local version cache for this command",
      "value": "boolean"
    },
    {
      "id": "runId",
      "flags": "--run-id <id>",
      "description": "Attach a run id to structured output and logs",
      "value": "string"
    },
    {
      "id": "timeout",
      "flags": "--timeout <duration>",
      "description": "Abort a command after the given duration, e.g. 500ms, 30s, 5m",
      "value": "string"
    }
  ],
