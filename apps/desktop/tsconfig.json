{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
