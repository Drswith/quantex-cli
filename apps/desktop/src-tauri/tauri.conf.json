{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantex Desktop",
  "version": "0.1.0",
  "identifier": "com.quantex.desktop",
  "build": {
    "beforeBuildCommand": "bun run --cwd ../.. desktop:prepare-sidecars && bun run build",
    "beforeDevCommand": "bun run --cwd ../.. desktop:prepare-sidecars && bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 720,
        "label": "main",
        "minHeight": 580,
        "minWidth": 860,
        "title": "Quantex Desktop",
        "width": 1080
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": ["resources/bin/quantex-darwin-arm64", "resources/bin/quantex-darwin-x64"],
    "targets": ["app", "dmg"]
  }
}
